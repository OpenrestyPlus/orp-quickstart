IMAGE_TAG=latest
BACKEND_IMAGE=registry.gitlab.com/your-group/orp-backend/control-plane
RUNTIME_IMAGE=registry.gitlab.com/your-group/orp-backend/openresty
FRONTEND_IMAGE=registry.gitlab.com/your-group/orp-frontend
IMPORTER_IMAGE=registry.gitlab.com/your-group/orp-nginx-importer
ADMIN_USERNAME=vben
ADMIN_PASSWORD=replace-with-generated-password
DATA_KEY=replace-with-64-hex-character-key
MYSQL_DATABASE=openresty-plus
MYSQL_USER=openresty-plus
MYSQL_PASSWORD=replace-with-generated-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-generated-mysql-root-password
WEB_PORT=8080
